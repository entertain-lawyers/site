{
  "name": "tmp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next/cache .netlify/.next/cache && prisma generate && AUTH_GOOGLE_SECRET=dummy-secret-not-real AUTH_GOOGLE_ID=dummy-id-not-real AUTH_SECRET=dummy-auth-secret-32-chars-long-12345 next build",
    "start": "next start",
    "lint": "eslint",
    "ai:index": "mkdir -p node_modules/.cache && esbuild scripts/rebuild-ai-index.ts --bundle --platform=node --format=esm --packages=external --alias:@=./src --alias:next/cache=./scripts/shims/next-cache.ts --outfile=node_modules/.cache/ai-index.mjs && NODE_ENV=test node node_modules/.cache/ai-index.mjs",
    "migration:extract": "node scripts/migration.js extract",
    "migration:stage": "node scripts/migration.js stage",
    "migration:validate": "node scripts/migration.js validate",
    "migration:import:staging": "node scripts/migration.js import",
    "migration:verify": "node scripts/migration.js verify",
    "migration:media": "node scripts/migration-media.js",
    "migration:redirects": "node scripts/migration-redirects.js",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-storage": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@measured/puck": "^0.20.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "isomorphic-dompurify": "^2.30.0",
    "lucide-react": "^1.47.0",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.11",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-quill-new": "^3.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
