# Production Environment Variables

# App (canonical domain; apex redirects to www)
NEXT_PUBLIC_APP_URL=https://www.entertainlawyers.com

# Auth
AUTH_SECRET=
ADMIN_EMAIL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database
DATABASE_URL=
DIRECT_URL=

# B2 Storage
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# Payments
KHALTI_SECRET_KEY=
KHALTI_PUBLIC_KEY=
ESEWA_SECRET_KEY=
ESEWA_MERCHANT_ID=
ESEWA_SUCCESS_URL=
ESEWA_FAILURE_URL=

# Feature flags (default false). Enable only with the matching service configured.
STORAGE_ENABLED=false
RATE_LIMITING_ENABLED=false
PAYMENTS_ENABLED=false

# Upstash Redis (required when RATE_LIMITING_ENABLED=true)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Outbound email (verification and password-reset codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@entertainlawyers.com
SMTP_SECURE=false

# WordPress REST API Integration
WP_ENGLISH_URL=https://entertainlawyers.com/wp-json/wp/v2
WP_NEPALI_URL=https://entertainlawyers.com/nepali/wp-json/wp/v2
WP_AUTH_HEADER=
# Alternatively, use Username + App Password:
# WP_AUTH_USERNAME=
# WP_AUTH_APP_PASSWORD=
