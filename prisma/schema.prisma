generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid())
  name            String?
  email           String               @unique
  emailVerified   DateTime?
  image           String?
  isEmailVerified Boolean              @default(false)
  passwordHash    String?
  role            Role                 @default(USER)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  accessLogs    AccessLog[]
  accounts      Account[]
  AuditLog      AuditLog[]
  builderPages  BuilderPage[]
  entitlements  Entitlement[]
  Event         Event[]
  transactions  PaymentTransaction[]
  posts         Post[]
  Publication   Publication[]
  purchases     Purchase[]
  sessions      Session[]
  subscriptions Subscription[]
  uploadIntents UploadIntent[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  durationDays  Int
  priceAmount   Int
  currency      String         @default("NPR")
  isActive      Boolean        @default(true)
  subscriptions Subscription[]
}

model Subscription {
  id               String               @id @default(uuid())
  userId           String
  planId           String
  status           SubStatus
  currentPeriodEnd DateTime
  createdAt     DateTime             @default(now())
  entitlements     Entitlement[]
  transactions     PaymentTransaction[]
  plan             Plan                 @relation(fields: [planId], references: [id])
  user             User                 @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Purchase {
  id           String               @id @default(uuid())
  userId       String
  resourceId   String
  amountPaid   Int
  currency     String               @default("NPR")
  createdAt     DateTime             @default(now())
  transactions PaymentTransaction[]
  resource     Resource             @relation(fields: [resourceId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])

  @@unique([userId, resourceId])
}

model PaymentTransaction {
  id             String        @id @default(uuid())
  userId         String
  provider       String
  providerRef    String?       @unique
  idempotencyKey String        @unique
  amount         Int
  currency       String        @default("NPR")
  type           TxType
  status         TxStatus      @default(PENDING)
  subscriptionId String?
  purchaseId     String?
  createdAt     DateTime             @default(now())
  updatedAt      DateTime      @updatedAt
  targetId       String?
  purchase       Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id])

  @@index([providerRef])
  @@index([userId, status])
}

model Entitlement {
  id             String            @id @default(uuid())
  userId         String
  sourceType     EntitlementSource
  expiresAt      DateTime?
  resourceId     String?
  subscriptionId String?
  resource       Resource?         @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@index([userId, resourceId])
}

model Semester {
  id       String    @id @default(uuid())
  name     String
  order    Int       @default(0)
  slug     String?   @unique
  subjects  Subject[]
  resources Resource[]
}

model Subject {
  id         String     @id @default(uuid())
  name       String
  semesterId String
  slug       String?    @unique
  order      Int        @default(0)
  resources  Resource[]
  semester   Semester   @relation(fields: [semesterId], references: [id])
  units      Unit[]
}

model Unit {
  id        String     @id @default(uuid())
  name      String
  title     String?
  order     Int        @default(0)
  subjectId String
  resources Resource[]
  subject   Subject    @relation(fields: [subjectId], references: [id])
}

model Resource {
  id            String         @id @default(uuid())
  title         String
  isPremium     Boolean        @default(false)
  subjectId     String?
  documentId    String?        @unique
  currency      String         @default("NPR")
  priceAmount   Int?
  order         Int?           @default(0)
  type          ResourceType   @default(LAW_NOTE)
  unitId        String?
  semesterId    String?
  metaDesc      String?
  metaTitle     String?
  status        ContentStatus  @default(PUBLISHED)
  accessLogs    AccessLog[]
  entitlements  Entitlement[]
  purchases     Purchase[]
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: Restrict)
  subject       Subject?       @relation(fields: [subjectId], references: [id])
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  semester      Semester?      @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  uploadIntents UploadIntent[]
  Category      Category[]
  Tag           Tag[]

  @@index([subjectId, type])
  @@index([unitId])
  @@index([semesterId])
}

model Document {
  id              String       @id @default(uuid())
  storageProvider String
  storageKey      String
  fileSize        Int
  mimeType        String
  accessLogs      AccessLog[]
  Publication     Publication?
  resource        Resource?
}

model UploadIntent {
  id               String       @id @default(uuid())
  resourceId       String
  storageKey       String       @unique
  expectedSize     Int
  expectedMimeType String
  adminId          String
  status           IntentStatus @default(PENDING)
  expiresAt        DateTime
  createdAt     DateTime             @default(now())
  updatedAt        DateTime     @updatedAt
  admin            User         @relation(fields: [adminId], references: [id])
  resource         Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId, status])
  @@index([adminId])
}

model Post {
  id        String        @id @default(uuid())
  title     String
  content   String
  type      PostType
  authorId  String?
  createdAt     DateTime             @default(now())
  updatedAt DateTime      @updatedAt
  status    ContentStatus @default(DRAFT)
  metaDesc  String?
  metaTitle String?
  author    User?         @relation(fields: [authorId], references: [id])
  Category  Category[]
  Tag       Tag[]

  @@index([type, status])
}

model AccessLog {
  id         String    @id @default(uuid())
  userId     String?
  resourceId String?
  documentId String?
  action     String
  ipAddress  String?
  userAgent  String?
  // Public page URL the event originated from (added for copy-protection
  // activity tracking; also useful for anonymous access analytics).
  url        String?
  createdAt     DateTime             @default(now())
  document   Document? @relation(fields: [documentId], references: [id])
  resource   Resource? @relation(fields: [resourceId], references: [id])
  user       User?     @relation(fields: [userId], references: [id])

  @@index([userId, action])
  @@index([resourceId])
  @@index([action, createdAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String
  details    Json?
  createdAt     DateTime             @default(now())
  User       User?       @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  Post        Post[]
  Resource    Resource[]
}

model Event {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?
  content       String?
  eventDate     DateTime
  location      String?
  featuredImage String?
  status        ContentStatus @default(DRAFT)
  metaTitle     String?
  metaDesc      String?
  authorId      String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime @updatedAt
  User          User?         @relation(fields: [authorId], references: [id])
}

/// Visual-builder page (drag & drop "Elementor-style" editing in /admin/pages).
/// `data` holds the Puck document (JSON); the public site renders it at /p/[slug].
model BuilderPage {
  id        String        @id @default(uuid())
  title     String
  slug      String        @unique
  data      Json
  status    ContentStatus @default(DRAFT)
  metaTitle String?
  metaDesc  String?
  authorId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  User      User?         @relation(fields: [authorId], references: [id])
}

model FAQ {
  language String        @default("en")
  id       String        @id @default(uuid())
  question String
  answer   String
  order    Int           @default(0)
  status   ContentStatus @default(PUBLISHED)
}

model Gallery {
  id           String         @id @default(uuid())
  title        String
  description  String?
  status       ContentStatus  @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt    DateTime @updatedAt
  GalleryImage GalleryImage[]
}

model GalleryImage {
  id        String   @id @default(uuid())
  galleryId String
  url       String
  altText   String?
  caption   String?
  order     Int      @default(0)
  createdAt     DateTime             @default(now())
  updatedAt DateTime @updatedAt
  Gallery   Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
}

model GlobalSettings {
  id               String   @id
  organizationName String   @default("Entertain Lawyers")
  contactEmail     String?
  contactPhone     String?
  address          String?
  facebookUrl      String?
  twitterUrl       String?
  instagramUrl     String?
  youtubeUrl       String?
  footerCopyright  String?
  updatedAt        DateTime @updatedAt
}

model HomepageConfig {
  id               String   @id
  heroHeading      String
  heroSubheading   String?
  heroCtaText      String?
  heroCtaLink      String?
  announcementText String?
  announcementLink String?
  updatedAt        DateTime @updatedAt
}

model Publication {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String?
  content     String?
  publishDate DateTime?
  coverImage  String?
  documentUrl String?
  documentId  String?       @unique
  status      ContentStatus @default(DRAFT)
  metaTitle   String?
  metaDesc    String?
  authorId    String?
  createdAt     DateTime             @default(now())
  updatedAt   DateTime @updatedAt
  User        User?         @relation(fields: [authorId], references: [id])
  Document    Document?     @relation(fields: [documentId], references: [id], onDelete: Restrict)
}

model Redirect {
  id          String   @id @default(uuid())
  source      String   @unique
  destination String
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt     DateTime             @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id       String     @id @default(uuid())
  name     String     @unique
  slug     String     @unique
  Post     Post[]
  Resource Resource[]
}

enum Role {
  USER
  ADMIN
  EDITOR
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TxType {
  SUBSCRIPTION
  PURCHASE
}

enum EntitlementSource {
  SUBSCRIPTION
  PURCHASE
}

enum ResourceType {
  LAW_NOTE
  CASE_LAW
  OLD_QUESTION
  OTHER
}

enum IntentStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum PostType {
  NEWS
  BLOG
  FACT
  OPINION
  NEPALI_SAMANYA_SAMACHAR
  NEPALI_ADALAT_SAMACHAR
  NEPALI_MUKHYA_SAMACHAR
  NEPALI_NAJIRHARU
  NEPALI_AIN_KANUN
  NEPALI_BLOG_BICHAR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String
  type       String
  expires    DateTime

  @@unique([identifier, token])
}

model TeamMember {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  designation    String
  shortBio       String?
  biography      String?
  imageUrl       String?
  phone          String?
  email          String?
  linkedinUrl    String?
  facebookUrl    String?
  websiteUrl     String?
  instagramUrl   String?
  qualifications String?  
  experience     String?  
  achievements   String?
  practiceAreas  String?  
  languages      String?  
  displayOrder   Int      @default(0)
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isPublished, displayOrder])
}

enum ConsultationStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ContactMethod {
  PHONE
  EMAIL
  WHATSAPP
}

enum ConsultationMode {
  PHYSICAL
  ONLINE
  EITHER
}

model ConsultationRequest {
  id                     String             @id @default(uuid())
  fullName               String
  email                  String
  phone                  String
  preferredContactMethod ContactMethod      @default(PHONE)
  consultationMode       ConsultationMode   @default(PHYSICAL)
  practiceArea           String
  preferredTime          String?
  claimAmount            Float?
  courtFeeEstimated      Float?
  subject                String
  description            String
  referralSource         String?
  status                 ConsultationStatus @default(NEW)
  adminNotes             String?
  ipAddress              String?
  userAgent              String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}
